# Copy to .env (next to app.py) and fill in what you need. Everything is optional — without it the app runs in demo mode.

# --- AI explanations (HemoScan, eligibility, assistant). Without a key the app uses built-in templates.
# Get a key: Anthropic console.anthropic.com · OpenAI platform.openai.com · Google aistudio.google.com
# Admin → AI Models → "Test AI connection" checks the key (the key itself is never shown).
LLM_PROVIDER=anthropic          # anthropic | openai | gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini            # OpenAI lists a 14 Jan 2027 shutdown for this model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash      # gemini-2.0-flash was retired on 1 Jun 2026

# --- Email alerts (any SMTP server: Gmail app password, Brevo, Mailgun, SendGrid SMTP, Outlook …)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-letter-app-password
# SMTP_FROM=HemoLink <you@gmail.com>
# SMTP_STARTTLS=1                  # 0 for port 465 / plain servers

# --- SMS alerts (Twilio). Use TWILIO_FROM=+1... or a Messaging Service SID. TWILIO_FROM=whatsapp:+14155238886 sends WhatsApp.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=

# --- Web push (phone / browser pop-ups). Works out of the box: a key pair is created in vapid_private.pem next to
# the database. On hosts that wipe files on restart (Render free), paste that PEM here so phones stay subscribed.
# VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# VAPID_SUBJECT=mailto:you@example.com

# --- Data protection
# HEMOLINK_DATA_KEY=           # encrypts uploaded blood test files; auto-created in data_key.txt — BACK IT UP
# HEMOLINK_REPORT_FILE_DAYS=365 # delete original report files after N days (confirmed values stay)

# --- App
# HEMOLINK_APP_URL=https://hemolink-ai.onrender.com   # used for the "Open HemoLink" link in emails
# HEMOLINK_SCHEDULER=on            # off = no automatic reminders / "donate again" alerts (admins can still run them)
# HEMOLINK_SECRET_KEY=long-random-string
# HEMOLINK_ENV=production
